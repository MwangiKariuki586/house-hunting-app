# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL (Neon) - Primary Database
# Pooled connection for application queries (via PgBouncer)
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xxx-pooler.us-east-1.aws.neon.tech/verifiednyumba?sslmode=require"

# Direct connection for Prisma migrations (bypasses connection pooler)
# Required for schema migrations and database operations
DIRECT_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/verifiednyumba?sslmode=require"

# One-off migration source
# Only required when running the MongoDB to PostgreSQL import script
MIGRATION_MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/verifiednyumba?retryWrites=true&w=majority"

# Optional safety switch for the import script
# Set to "true" only when you want the target PostgreSQL database cleared before import
RESET_POSTGRES="false"

# ============================================
# JWT CONFIGURATION
# ============================================

# Generate a secure random string (min 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-token-secret-key-min-32-characters"

# Token Expiry (in seconds or time strings like '15m', '7d')
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================

# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================
# EXTERNAL SERVICES
# ============================================

# Optional: Socket.io for real-time chat
SOCKET_URL="http://localhost:3001"

# Optional: ReSend for email notifications
RESEND_API_KEY="re_your_key_here"
